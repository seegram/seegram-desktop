using "info/info.style";

seetgVerificationBadgeScale: 0.95;
seetgVerificationBadgeSkip: 4px;
seetgVerificationMinTitleWidth: 64px;
seetgVerificationDescriptionIcon: 18px;
seetgVerificationDescriptionSkip: 7px;
seetgVerificationPadding: margins(22px, 8px, 22px, 8px);
seetgVerificationDescription: FlatLabel(defaultFlatLabel) {
	minWidth: 1px;
	align: align(topleft);
	textFg: windowSubTextFg;
}
