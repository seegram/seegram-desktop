using "info/info.style";

seetgCommentsIcon: icon {{ "menu/discussion", infoIconFg, point(4px, 4px) }};
seetgCommentAvatar: 36px;
seetgCommentAvatarSkip: 10px;
seetgCommentBadge: 16px;
seetgCommentPadding: 16px;
seetgCommentGap: 10px;
seetgCommentText: FlatLabel(defaultFlatLabel) {
	minWidth: 1px;
	align: align(topleft);
	textFg: windowFg;
}
seetgCommentMeta: FlatLabel(seetgCommentText) {
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
	textFg: windowSubTextFg;
}
seetgCommentReply: LinkButton(defaultLinkButton) {
	font: font(12px);
	overFont: font(12px);
}
seetgCommentInput: InputField(defaultInputField) {
	textBg: boxDividerBg;
	textBgActive: boxDividerBg;
	textMargins: margins(10px, 9px, 10px, 9px);
	placeholderMargins: margins(10px, 9px, 10px, 9px);
	placeholderFont: font(13px);
	placeholderScale: 1.0;
	placeholderShift: 0px;
	border: 0px;
	borderActive: 0px;
	borderRadius: 10px;
	heightMin: 36px;
	heightMax: 96px;
}
